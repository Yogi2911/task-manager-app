pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "iamyoga/task-manager"
        APP_PORT = "4000"
        CONTAINER_NAME = "task-manager-dev"
    }

    options {
        timestamps()
        disableConcurrentBuilds()

        // Maximum pipeline execution time
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Yogi2911/task-manager-app.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat """
                    echo ========================================
                    echo Building Docker Image
                    echo ========================================

                    docker build -t %DOCKER_IMAGE%:%BUILD_NUMBER% .

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker image build failed
                        exit /b 1
                    )

                    echo Docker image built successfully
                    echo Image: %DOCKER_IMAGE%:%BUILD_NUMBER%
                """
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat """
                        echo Logging into Docker Hub

                        powershell -NoProfile -Command ^
                        "\$env:DOCKER_PASSWORD | docker login --username \$env:DOCKER_USER --password-stdin"

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker Hub login failed
                            exit /b 1
                        )

                        echo Docker Hub login successful
                    """
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                bat """
                    echo ========================================
                    echo Pushing Docker Image
                    echo ========================================

                    docker push %DOCKER_IMAGE%:%BUILD_NUMBER%

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker image push failed
                        exit /b 1
                    )

                    echo Docker image pushed successfully
                """
            }
        }

        stage('Get Previous Version') {
            steps {
                script {

                    def previousBuild = currentBuild.previousSuccessfulBuild

                    if (previousBuild != null) {
                        env.PREVIOUS_VERSION = previousBuild.number.toString()
                    } else {
                        env.PREVIOUS_VERSION = ""
                    }

                    echo "Current version  : ${env.BUILD_NUMBER}"
                    echo "Previous version : ${env.PREVIOUS_VERSION}"
                }
            }
        }

        stage('Deploy to Development') {
            steps {
                bat """
                    echo ========================================
                    echo Deploying to Development
                    echo ========================================

                    echo Stopping existing container...

                    docker rm -f %CONTAINER_NAME% 2>NUL

                    echo Starting new container...

                    docker run -d ^
                        --name %CONTAINER_NAME% ^
                        -p %APP_PORT%:%APP_PORT% ^
                        %DOCKER_IMAGE%:%BUILD_NUMBER%

                    if %ERRORLEVEL% NEQ 0 (
                        echo Deployment failed
                        exit /b 1
                    )

                    echo Container started successfully

                    docker ps --filter "name=%CONTAINER_NAME%"
                """
            }
        }

        stage('Deployment Verification') {
            steps {
                bat """
                    echo ========================================
                    echo Deployment Verification
                    echo ========================================

                    echo Waiting for application to start...

                    ping -n 6 127.0.0.1 >nul

                    echo Checking health endpoint...

                    curl -f http://localhost:%APP_PORT%/api/health

                    if %ERRORLEVEL% NEQ 0 (
                        echo ========================================
                        echo HEALTH CHECK FAILED
                        echo ========================================
                        exit /b 1
                    )

                    echo ========================================
                    echo HEALTH CHECK SUCCESSFUL
                    echo ========================================

                    echo Application is running:
                    echo http://localhost:%APP_PORT%/api/health
                """
            }
        }
    }

    post {

        failure {
            script {

                echo "========================================"
                echo "DEPLOYMENT FAILED"
                echo "Starting automatic rollback"
                echo "========================================"

                if (env.PREVIOUS_VERSION?.trim()) {

                    echo "Rolling back to version: ${env.PREVIOUS_VERSION}"

                    bat """
                        echo Stopping failed container...

                        docker rm -f %CONTAINER_NAME% 2>NUL

                        echo Starting previous version...

                        docker run -d ^
                            --name %CONTAINER_NAME% ^
                            -p %APP_PORT%:%APP_PORT% ^
                            %DOCKER_IMAGE%:%PREVIOUS_VERSION%

                        if %ERRORLEVEL% NEQ 0 (
                            echo ROLLBACK FAILED
                            exit /b 1
                        )

                        echo Previous version started successfully

                        docker ps --filter "name=%CONTAINER_NAME%"
                    """

                    bat """
                        echo ========================================
                        echo Verifying rollback
                        echo ========================================

                        ping -n 6 127.0.0.1 >nul

                        curl -f http://localhost:%APP_PORT%/api/health

                        if %ERRORLEVEL% NEQ 0 (
                            echo ROLLBACK VERIFICATION FAILED
                            exit /b 1
                        )

                        echo ========================================
                        echo ROLLBACK SUCCESSFUL
                        echo ========================================
                        echo Restored version: %PREVIOUS_VERSION%
                    """

                } else {

                    echo "No previous successful build available."
                    echo "Rollback cannot be performed."
                }
            }
        }

        always {
            bat """
                docker logout || exit 0
            """
        }

        success {
            echo "========================================"
            echo "Task Manager Docker CI/CD succeeded."
            echo "Deployed version: ${env.BUILD_NUMBER}"
            echo "========================================"
        }
    }
}
